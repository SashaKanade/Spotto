# PostgreSQL (Supabase) — include PostGIS
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Backend
PORT=3001
NODE_ENV=development

# Anthropic (API routes only — never expose to the web client)
ANTHROPIC_API_KEY=

# Optional: comma-separated origins for CORS (defaults to Vite dev server)
CORS_ORIGIN=http://localhost:5173
